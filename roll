#!/usr/bin/env python3
# coding: utf-8
import sys

from dice import dice_roller, stats_roll, dir_roll


def info() -> None:
    """Print usage information."""
    print('Syntax is: roll <dice_code>\nExample: roll 2d8 + 6 + d8')
    print('Instead of a dice code you can also put "stats" or "dir" '
          'for a stats roll or direction roll respectively')


def error() -> None:
    """Print usage information and exit with an error code."""
    info()
    sys.exit(2)


def main() -> None:
    """Entry point: parse arguments and dispatch to the appropriate roller."""
    if len(sys.argv) == 1:
        error()

    input_string = ''.join(sys.argv[1:])

    if 'stats' in input_string.lower():
        print(stats_roll())
        sys.exit(0)

    if 'dir' in input_string.lower():
        print(dir_roll())
        sys.exit(0)

    if '-h' in input_string.lower():
        info()
        sys.exit(0)

    try:
        total, rolls = dice_roller(input_string)
        print(f"Total: {total}")
        for r in rolls:
            value, sides = r.split('/')
            print(f"  d{sides}: {value}")
    except ZeroDivisionError:
        print("You cannot divide by zero")
        sys.exit(2)
    except (ValueError, IndexError):
        error()


if __name__ == "__main__":
    main()
